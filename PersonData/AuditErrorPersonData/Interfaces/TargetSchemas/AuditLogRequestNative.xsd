<?xml version = '1.0' encoding = 'UTF-8'?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://persondata.org/auditerror" targetNamespace="http://persondata.org/auditerror" elementFormDefault="qualified" xmlns:nxsd="http://xmlns.oracle.com/pcbpel/nxsd" nxsd:version="JSON" nxsd:encoding="UTF-8">
   <xsd:element name="AuditLogRequest">
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element name="messageUID" type="xsd:string"/>
            <xsd:element name="transactionId" type="xsd:string"/>
            <xsd:element name="componentName" type="xsd:string"/>
            <xsd:element name="applicationServerId" type="xsd:string"/>
            <xsd:element name="businessKeys">
               <xsd:complexType>
                  <xsd:sequence>
                     <xsd:element name="keyName" type="xsd:string"/>
                     <xsd:element name="keyValue" type="xsd:string"/>
                  </xsd:sequence>
               </xsd:complexType>
            </xsd:element>
            <xsd:element name="description" type="xsd:string"/>
            <xsd:element name="txnSourceCreateTimestamp" type="xsd:string"/>
            <xsd:element name="startTimestamp" type="xsd:string"/>
            <xsd:element name="endTimestamp" type="xsd:string"/>
